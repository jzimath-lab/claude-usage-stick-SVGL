# LAN listener. Stick firmware matches instance `estacao` (ESTACAO_MDNS_HOST).
# A custom MDNS_NAME is ignored so the stick stays discoverable without a reflash.
PORT=8787
HOST=0.0.0.0
MDNS_NAME=estacao

# Poll each source independently (ms). Spec: 60–120 s.
POLL_MS=90000

# --- Actions via G1 (pick ONE; never put secrets in git) ---
#
# 1) Production collector already running (preferred):
#    G1 estacao-server GET /api/github  (DEVICE_TOKEN, not PAINEL_TOKEN)
# G1_URL=http://127.0.0.1:3010/api/github
# G1_DEVICE_TOKEN=
#
# 2) Require the G1 module in-tree / sibling checkout and call buscarBilling.
#    G1_DIR = root of the G1 estacao tree (the folder that contains server/services/github.js)
# G1_DIR=/docker/estacao
# GITHUB_TOKEN=
# GITHUB_USER=
# GH_INCLUIDOS=2000
#
# Tests only — path to a saved /api/github JSON. Do not set in production.
# G1_FIXTURE=

# --- Codex (pick the first that has sourced usage; never put tokens in git) ---
# Applies = some window has usedPct (including measured 0%). HTTP 200 / CLI
# exit 0 that maps to no_source continues to auth.json+wham, then app-server.
#
# 1) Existing `codexbar serve` on the station:
# CODEXBAR_URL=http://127.0.0.1:8080
# CODEXBAR_TOKEN=
#
# 2) `codexbar` on PATH — used automatically:
#    codexbar usage --format json --provider codex
#
# 3) Closed list: ~/.codex/auth.json or $CODEX_HOME/auth.json
#    → GET https://chatgpt.com/backend-api/wham/usage
# CODEX_HOME=
#
# 4) `codex` on PATH — RPC `codex -s read-only -a never app-server`
#    → account/rateLimits/read
#
# Tests only — saved CodexBar usage JSON. Do not set in production.
# CODEX_FIXTURE=

# --- Cursor / Grok Bot (CLI before serve; pick the first with sourced usage) ---
#
# 1) `codexbar` on PATH — used automatically:
#    codexbar usage --format json --provider cursor
#
# 2) Existing `codexbar serve` (same CODEXBAR_URL as Codex, provider=cursor):
# CODEXBAR_URL=http://127.0.0.1:8080
#
# 3) Closed list — pasted cookie (required on Linux; never auto-imports a browser):
#    Cookie: WorkosCursorSessionToken / __Secure-next-auth.session-token / next-auth.session-token
# CURSOR_COOKIE=
#
# 4) Closed list — Cursor.app token (macOS default state.vscdb; or set the path):
#    cursorAuth/accessToken → GET https://cursor.com/api/usage-summary
#    Grok Bot: POST https://cursor.com/api/dashboard/get-sand-usage-status
# CURSOR_TOKEN=
# CURSOR_VSCDB=
#
# Tests only — saved CodexBar cursor usage JSON. Do not set in production.
# CURSOR_FIXTURE=

# --- Gemini (CLI before serve; pick the first with sourced usage) ---
#
# Probe before painting a number. Consumer OAuth (individual / AI Pro / Ultra)
# may be dead since 2026-06-18 → SEM FONTE, never 0%, never Antigravity.
#
# 1) `codexbar` on PATH — used automatically:
#    codexbar usage --format json --provider gemini
#
# 2) Existing `codexbar serve` (same CODEXBAR_URL, provider=gemini):
# CODEXBAR_URL=http://127.0.0.1:8080
#
# 3) Closed list: ~/.gemini/oauth_creds.json
#    → POST https://cloudcode-pa.googleapis.com/v1internal:retrieveUserQuota
# GEMINI_CREDS=
#
# Out of v1: loadCodeAssist, Cloud Billing, AI Studio scrape, Antigravity.
# Never put tokens in git. The stick never opens oauth_creds.json.
#
# Tests only — saved CodexBar gemini usage JSON. Do not set in production.
# GEMINI_FIXTURE=
